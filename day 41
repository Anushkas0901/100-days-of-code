#include <stdio.h>

int main() {
    int n, first, last, middle, digits, result;

    printf("Enter a number: ");
    scanf("%d", &n);

    last = n % 10;

    digits = 1;
    middle = n;

    while (middle >= 10) {
        middle = middle / 10;
        digits = digits * 10;
    }

    first = middle;

    middle = (n % digits) / 10;

    result = last * digits + middle * 10 + first;

    printf("Number after swapping = %d", result);

    return 0;
}
